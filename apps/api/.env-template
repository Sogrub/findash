# Node Environment Variables
NODE_ENV="development"
PORT=3000
REQUEST_TIMEOUT=30000
APP_NAME="findash"
API_VERSION="v1"
FRONTEND_URL="http://localhost:4200"

# Swagger Environment Variables
APP_TITLE="FinDash API"
APP_DESCRIPTION="FinDash Billetera Digital - REST API"
APP_VERSION="1.0.0"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/findash"

# JWT
JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN="1d"

# Google OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"