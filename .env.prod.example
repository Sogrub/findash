# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
REQUEST_TIMEOUT=30000
APP_NAME=findash
API_VERSION=1
FRONTEND_URL=http://YOUR_VM_IP

# ── Swagger ───────────────────────────────────────────────────────────────────
APP_TITLE=FinDash API
APP_DESCRIPTION=FinDash Billetera Digital - REST API
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=findash
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=findash
DATABASE_URL=postgresql://findash:CHANGE_ME_strong_password_here@postgres:5432/findash

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_here
JWT_EXPIRES_IN=1d

# ── Google OAuth (leave empty to disable) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://YOUR_VM_IP/api/v1/auth/google/callback

# ── Docker images (set by CI/CD — update manually if deploying without CI) ────
API_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/findash/api:latest
WEB_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/findash/web:latest
